# ---- Balanceador ----
# Política de balanceo: round_robin | least_conn | ip_hash
BALANCE_POLICY=round_robin
# Número de procesos worker de NGINX (un número o "auto")
NGINX_WORKERS=2
# Puerto público del balanceador en la máquina host
PUBLIC_PORT=8080
# Puerto de la interfaz web de Prometheus
PROMETHEUS_PORT=9091

# ---- Aplicación TecnoStore ----
# Dónde se guarda el carrito: db (base de datos compartida) | memory (memoria de cada backend)
CART_STORAGE=db
# Hilos de Gunicorn por backend (peticiones simultáneas que atiende cada uno)
GUNICORN_THREADS=32
# Conexiones a MySQL por backend
DB_POOL_SIZE=10

# ---- Base de datos MySQL ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=techstore
MYSQL_USER=tienda
MYSQL_PASSWORD=tienda123
